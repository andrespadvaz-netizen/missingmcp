FROM python:3.12-slim
RUN pip install --no-cache-dir uv
WORKDIR /app

# Deliberately no Garmin worker, connector package, git dependency, or gateway
# process: this image contains only the isolated Apple Health OS service.
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN uv pip install --system .
CMD ["health-os"]
EXPOSE 8080
